# ============================================
# URBEX PROYECTOS - Docker Ignore
# Archivos a excluir del contexto de Docker
# ============================================

# Dependencias (se instalan en el build)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output (se genera en el build)
.next
out

# Archivos de desarrollo
.env*.local
.env.development
.env.test

# IDE y editores
.vscode
.idea
*.swp
*.swo
*~

# Git
.git
.gitignore

# Documentación (no necesaria en producción)
*.md
docs

# Tests
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage
.nyc_output

# Archivos de configuración de desarrollo
.bolt
.eslintcache
.prettierrc
.editorconfig

# Otros archivos innecesarios
*.log
*.pid
*.seed
*.pid.lock
.DS_Store
Thumbs.db

# Archivos de TypeScript compilados
*.tsbuildinfo

# Carpetas temporales
tmp
temp
.cache
